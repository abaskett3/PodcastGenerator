<Project Sdk="Microsoft.NET.Sdk">

  <!-- Clean Architecture: Infrastructure references Application (and through it Domain). All OpenRouter/HTTP code and
       all third-party audio code lives here. -->
  <ItemGroup>
    <ProjectReference Include="..\PodcastGenerator.Application\PodcastGenerator.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <!-- Pure managed MP3 encoder (LGPL-3.0): see docs/designs/initial-development.md, "Audio library". -->
    <PackageReference Include="GroovyMp3" Version="0.1.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\default-style.md" LogicalName="PodcastGenerator.Resources.default-style.md" />
  </ItemGroup>

</Project>
